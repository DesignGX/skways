# ------------------------------------------------------------------
# SK Ways Logistics — environment variables
# Copy this file to .env.local and fill in the values from your
# Supabase project (Project Settings → API).
# ------------------------------------------------------------------

# Supabase project URL (e.g. https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service role key — SECRET. Server-only. Never ship to the
# browser. Used for admin operations that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=